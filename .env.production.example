# ═══ Maison Horlogère — production settings (Hostinger VPS) ════════════════════
# 1. Copy this file:   cp .env.production.example .env.production
# 2. Fill in the values below (deployment day).
# 3. Run:              ./deploy.sh
#
# .env.production is git-ignored — it never leaves your Mac except over SSH to your
# own server. Anything left blank that says "auto" is generated for you on first deploy
# and written back into this file, so keep the file safe (it holds your DB password).
# Values with special characters ($ " # spaces): wrap them in single quotes, e.g. SMTP_PASSWORD='pa$$"word'.

# ─── 1. VPS (Hostinger → VPS → Overview → SSH access) ──────────────────────────
DEPLOY_HOST=""                  # server IP, e.g. 72.61.123.45
DEPLOY_USER="root"              # Hostinger VPS default
DEPLOY_SSH_PORT="22"
DEPLOY_SSH_KEY=""               # optional: path to a private key, e.g. ~/.ssh/id_ed25519 (blank = your default key, or a password prompt)
DEPLOY_PATH="/var/www/maison"   # where the app lives on the server
APP_PORT="3000"                 # internal port (Nginx proxies to it; never exposed)

# ─── 2. Domain & HTTPS ────────────────────────────────────────────────────────
# Point the domain's A record (and www, if used) at DEPLOY_HOST first.
# Hostinger → Domains → DNS / Nameservers → A record "@" and "www" → your VPS IP.
DOMAIN=""                       # e.g. maisonhorlogere.in   (no https://, no slash)
DOMAIN_WWW="true"               # also serve www.DOMAIN (redirects to DOMAIN)
LETSENCRYPT_EMAIL=""            # expiry notices for the free SSL certificate
# The site URL, AUTH_URL and image folder are derived from DOMAIN / DEPLOY_PATH automatically.

# ─── 3. Database ──────────────────────────────────────────────────────────────
# Leave blank (recommended): PostgreSQL is installed on the VPS, and a database, user and
# strong password are created automatically. Nightly backups are kept for 14 days.
# Or paste an external Postgres URL (Neon, Supabase…) to use that instead.
DATABASE_URL=""                 # auto
DIRECT_URL=""                   # only for pooled external DBs (Neon): the direct URL for migrations

# ─── 4. Sign-in & admins ──────────────────────────────────────────────────────
AUTH_SECRET=""                  # auto (random 32-byte secret)
ADMIN_EMAILS=""                 # comma-separated; these accounts become admins when they sign in

# Google sign-in (optional — the button appears only when both are set)
# Google Cloud console → Credentials → OAuth client → redirect URI: https://DOMAIN/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── 5. Email (order updates, sign-in codes) ──────────────────────────────────
# Option A — Hostinger email (hPanel → Emails → your mailbox → "Configuration settings"):
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"                 # 465 = SSL/TLS (Hostinger). Use 587 for STARTTLS providers.
SMTP_USER=""                    # full mailbox address, e.g. orders@maisonhorlogere.in
SMTP_PASSWORD=""
EMAIL_FROM=""                   # e.g. "Maison Horlogère <orders@maisonhorlogere.in>" — must be the SMTP mailbox (or an alias of it)
# Option B — Resend (resend.com): leave SMTP_USER blank and set this instead.
RESEND_API_KEY=""

# ─── 6. Optional ──────────────────────────────────────────────────────────────
# Product photos you upload in Admin are stored on the VPS disk by default (backed up nightly).
# Set all three to store them on Cloudinary instead.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Android app: put the APK at public/downloads/maison-horlogere.apk, then set this to
# "/downloads/maison-horlogere.apk" (or a full https URL). Blank hides the header "App" button.
NEXT_PUBLIC_APK_URL=""

SENTRY_DSN=""
LOG_LEVEL="info"
