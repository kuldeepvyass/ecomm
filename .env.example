# ─── Maison Horlogère — environment variables (local development) ───────────
# Copy to .env for local development. For the live server use .env.production.example + ./deploy.sh.
# Never commit real values. Only NEXT_PUBLIC_* values reach the browser.

# Database (Neon: use the POOLED url for DATABASE_URL and the DIRECT url for migrations)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="https://your-domain.com"          # http://localhost:3100 locally
NEXT_PUBLIC_SITE_URL="https://your-domain.com"
# Comma-separated emails that become ADMIN on sign-in
ADMIN_EMAILS="you@example.com"

# Google sign-in (optional — the button appears only when both are set)
# Redirect URI: https://your-domain.com/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email: SMTP (e.g. Hostinger mail) or Resend. With neither, emails are written to .dev-mail/
# (visible at /dev/mail) in development.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
RESEND_API_KEY=""
EMAIL_FROM="Maison Horlogère <orders@your-domain.com>"

# Images: stored on disk in UPLOAD_DIR (default ./.media, served at /media/) unless Cloudinary is set.
UPLOAD_DIR=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Payments: none needed. Customers pay your UPI ID directly (set it in Admin → Settings → UPI payments).

# Error tracking (optional)
SENTRY_DSN=""
LOG_LEVEL="info"

# Android app (built with a website→APK converter). Put the file at public/downloads/maison-horlogere.apk
# (or host it elsewhere and use the full https URL). Leave empty to hide the "App" button.
# Tip: give the converter the start URL https://<your-domain>/?source=app
NEXT_PUBLIC_APK_URL="/downloads/maison-horlogere.apk"
