// Luxury Watch Store — Prisma schema (draft for review)
// Money is stored as Int rupees (prices are rounded to the nearest rupee; GST-inclusive).
// Razorpay amounts are derived as rupees * 100 at the boundary.
// Percentages use Decimal(5,2) so values like 7.5 are exact.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions", "fullTextSearchPostgres"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm, citext]
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
}

enum Gender {
  MEN
  WOMEN
  UNISEX
}

enum Movement {
  AUTOMATIC
  QUARTZ
  MANUAL
  SOLAR   // light-powered quartz (e.g. Eco-Drive)
  KINETIC // automatic quartz
  SMART   // smart / hybrid smart
}

enum ProductStatus {
  DRAFT
  ACTIVE
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_SUBMITTED // customer submitted a UPI UTR; awaiting manual verification
  PAID
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  PAYMENT_FAILED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

enum PaymentMethod {
  UPI // direct UPI to the store's VPA, verified manually by UTR (the only method)
}

enum PaymentStatus {
  SUBMITTED // UTR received, not yet checked
  CONFIRMED // admin matched the UTR + amount in the bank/UPI app
  REJECTED  // UTR not found / amount mismatch
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CouponType {
  PERCENT
  FLAT
}

enum ReturnType {
  RETURN
  EXCHANGE
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  PICKED_UP
  COMPLETED
}

enum ImportKind {
  IMPORT        // create + update (upsert on SKU)
  BULK_UPDATE   // update only the columns present, matched on SKU
  BULK_DELETE   // soft-delete / deactivate by SKU list
  EXPORT
}

enum ImportStatus {
  VALIDATING
  PREVIEW       // parsed + validated, awaiting admin confirmation
  RUNNING
  COMPLETED
  FAILED
}

enum PriceChangeScope {
  GLOBAL_DISCOUNT
  PRODUCT_OVERRIDE
  PRODUCT_EXCLUDE_FLAG
  PRODUCT_MRP
}

// ─────────────────────────────────────────────────────────────
// Auth.js (Prisma adapter) + users
// ─────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique @db.Citext
  emailVerified DateTime?
  image         String?
  phone         String?
  role          Role      @default(CUSTOMER)
  blockedAt     DateTime?

  // Notification preferences
  notifyOrderEmails Boolean @default(true) // transactional; cannot be fully disabled for legal mails
  notifyMarketing   Boolean @default(false)
  notifyBackInStock Boolean @default(true)

  deletedAt DateTime? // account deletion = anonymise PII + set this; orders kept for GST records
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  addresses     Address[]
  cart          Cart?
  wishlist      WishlistItem[]
  orders        Order[]
  reviews       Review[]
  reviewVotes   ReviewVote[]
  couponUses    CouponRedemption[]
  stockAlerts   StockAlert[]
  auditLogs     AuditLog[]        @relation("AuditActor")
  priceChanges  PriceChangeLog[]  @relation("PriceActor")
  imports       ImportJob[]
  statusEvents  OrderStatusEvent[] @relation("StatusActor")
  paymentReviews Payment[]        @relation("PaymentReviewer")

  @@index([role])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  attempts   Int      @default(0) // OTP brute-force guard

  @@unique([identifier, token])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  label      String?  // "Home", "Office"
  fullName   String
  phone      String   // 10-digit Indian mobile
  line1      String
  line2      String?
  landmark   String?
  city       String
  state      String   // validated against list of Indian states/UTs
  pincode    String   @db.Char(6)
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// Catalog
// ─────────────────────────────────────────────────────────────

model Brand {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  tagline     String?
  origin      String?  // e.g. "Italy (fashion brand)", "Switzerland"
  story       String?  @db.Text
  logoUrl     String?
  heroImage   String?
  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Collection {
  id          String   @id @default(cuid())
  name        String   @unique // Dress, Dive, Chronograph, Limited Edition …
  slug        String   @unique
  description String?  @db.Text
  heroImage   String?
  sortOrder   Int      @default(0)
  showOnHome  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products ProductCollection[]
}

model ProductCollection {
  productId    String
  collectionId String
  position     Int @default(0)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@index([collectionId, position])
}

model Product {
  id              String        @id @default(cuid())
  brandId         String
  modelName       String
  referenceNumber String
  slug            String        @unique
  sku             String        @unique
  description     String        @db.Text
  status          ProductStatus @default(DRAFT)
  featured        Boolean       @default(false)
  gender          Gender

  // Pricing (rupees, GST-inclusive)
  mrp                       Int
  costPrice                 Int?          // admin-only, never selected in storefront queries
  discountOverridePct       Decimal?      @db.Decimal(5, 2) // wins over global
  excludeFromGlobalDiscount Boolean       @default(false)
  // Denormalised, recomputed server-side whenever MRP / override / global % changes,
  // so listing pages can filter + sort by price in SQL. Never accepted from the client.
  sellingPrice              Int
  effectiveDiscountPct      Decimal       @default(0) @db.Decimal(5, 2)
  hsnCode                   String        @default("9102")
  gstRatePct                Decimal       @default(18) @db.Decimal(5, 2)

  // Inventory
  stock          Int @default(0)
  lowStockAt     Int @default(2)

  // Classification (from the dataset)
  series          String? // the brand's product line, e.g. "Armani Exchange Chronograph"
  watchType       String? // Chronograph, Analog, Diver, Digital, Smart…
  caseShape       String? // Round, Square, Rectangular, Tonneau…
  strapType       String? // derived category for filtering: Metal bracelet, Leather, Rubber/Silicone, Mesh, Fabric, Ceramic
  functions       String? // e.g. "Chronograph (1/10 s), small seconds, date"
  specialFeatures String? // short highlight, e.g. "All-black sports chronograph"

  // Specs
  caseMaterial      String
  caseDiameterMm    Decimal  @db.Decimal(4, 1)
  caseThicknessMm   Decimal? @db.Decimal(4, 1)
  lugWidthMm        Int?
  dialColour        String
  strapMaterial     String   // "Steel bracelet", "Alligator leather", "Rubber" …
  strapColour       String?
  movement          Movement
  calibre           String?
  powerReserveHours Int?
  waterResistanceM  Int?
  crystal           String?
  weightGrams       Int?
  warrantyMonths    Int?
  boxAndPapers      Boolean  @default(true)

  // SEO
  seoTitle       String?
  seoDescription String?

  // Real review aggregates (approved, non-demo reviews only — maintained transactionally)
  ratingAvg    Decimal @default(0) @db.Decimal(2, 1)
  ratingCount  Int     @default(0)
  ratingDist   Int[]   @default([0, 0, 0, 0, 0]) // counts for 1★..5★

  // Optional attributed external rating (copied from a named source; never generated)
  externalRating       Decimal? @db.Decimal(2, 1)
  externalRatingCount  Int?
  externalRatingSource String?

  // Popularity signals
  viewCount  Int @default(0)
  soldCount  Int @default(0)

  // Search: brand + model + reference + calibre, maintained by app on write; trigram-indexed
  searchText String @default("")

  isDemo    Boolean   @default(false)
  deletedAt DateTime? // soft delete (restorable)
  /// GENERATED ALWAYS in SQL (see migration recommended_rank) — never written by the app.
  /// Analog > smart, featured, automatic/manual, rating ≥ 4.5. Drives the default "Recommended" sort.
  rankScore Int @default(dbgenerated())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  brand        Brand               @relation(fields: [brandId], references: [id], onDelete: Restrict)
  images       ProductImage[]
  collections  ProductCollection[]
  reviews      Review[]
  wishlistedBy WishlistItem[]
  cartItems    CartItem[]
  orderItems   OrderItem[]
  stockAlerts  StockAlert[]
  priceChanges PriceChangeLog[]

  @@unique([brandId, referenceNumber])
  @@index([status, deletedAt, createdAt(sort: Desc), id]) // cursor pagination (newest)
  @@index([status, deletedAt, sellingPrice, id])         // price sort / range filter
  @@index([brandId, status])
  @@index([gender, status])
  @@index([movement])
  @@index([caseDiameterMm])
  @@index([watchType])
  @@index([caseShape])
  @@index([strapType])
  @@index([featured, status])
  @@index([soldCount(sort: Desc)])
  @@index([ratingAvg(sort: Desc)])
  @@index([isDemo])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin) // typo-tolerant search
}

model ProductImage {
  id          String  @id @default(cuid())
  productId   String
  url         String  // Cloudinary secure_url (f_auto,q_auto delivered via loader)
  publicId    String? // Cloudinary public_id for deletion
  alt         String
  width       Int
  height      Int
  blurDataUrl String? @db.Text
  position    Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

// ─────────────────────────────────────────────────────────────
// Reviews (only verified purchasers; demo reviews flagged)
// ─────────────────────────────────────────────────────────────

model Review {
  id              String       @id @default(cuid())
  productId       String
  userId          String?      // null only for isDemo reviews
  orderItemId     String?      @unique // the delivered order line that grants eligibility
  authorName      String       // display name snapshot ("Arjun M.")
  rating          Int          // 1–5, enforced by Zod + CHECK constraint in migration
  title           String
  body            String       @db.Text
  status          ReviewStatus @default(PENDING)
  verifiedPurchase Boolean     @default(false)
  helpfulCount    Int          @default(0)
  storeReply      String?      @db.Text
  storeRepliedAt  DateTime?
  isDemo          Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderItem OrderItem?    @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  images    ReviewImage[]
  votes     ReviewVote[]

  @@unique([productId, userId]) // one review per customer per product
  @@index([productId, status, createdAt(sort: Desc)])
  @@index([productId, status, helpfulCount(sort: Desc)])
  @@index([status, createdAt])
  @@index([isDemo])
}

model ReviewImage {
  id       String @id @default(cuid())
  reviewId String
  url      String
  publicId String?
  width    Int
  height   Int
  position Int    @default(0)

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

model ReviewVote {
  reviewId  String
  userId    String
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([reviewId, userId])
}

// ─────────────────────────────────────────────────────────────
// Wishlist, cart
// ─────────────────────────────────────────────────────────────

model WishlistItem {
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([productId])
}

model Cart {
  id         String    @id @default(cuid())
  userId     String?   @unique
  guestToken String?   @unique // signed httpOnly cookie for guests; merged into user cart on login
  couponCode String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  expiresAt  DateTime? // guest carts pruned after 30 days

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id            String   @id @default(cuid())
  cartId        String
  productId     String
  quantity      Int      @default(1)
  savedForLater Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
}

model StockAlert {
  id         String    @id @default(cuid())
  productId  String
  email      String    @db.Citext
  userId     String?
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([productId, email])
  @@index([productId, notifiedAt])
}

// ─────────────────────────────────────────────────────────────
// Orders, payments, returns
// ─────────────────────────────────────────────────────────────

model Order {
  id             String        @id @default(cuid())
  orderNumber    String        @unique // e.g. LW-2026-000123
  userId         String
  status         OrderStatus   @default(PENDING_PAYMENT)
  paymentMethod  PaymentMethod
  deliveryOption String        @default("STANDARD") // STANDARD | EXPRESS
  idempotencyKey String        @unique // client-generated per checkout attempt → no duplicate orders

  // Address snapshot (immutable after placing)
  shipName     String
  shipPhone    String
  shipLine1    String
  shipLine2    String?
  shipLandmark String?
  shipCity     String
  shipState    String
  shipPincode  String @db.Char(6)

  // Totals (rupees, all computed server-side)
  mrpTotal        Int // Σ mrp × qty
  itemsTotal      Int // Σ sellingPrice × qty (after product discount)
  couponDiscount  Int @default(0)
  shippingFee     Int @default(0)
  grandTotal      Int
  taxableValue    Int // grandTotal back-calculated ex-GST
  cgst            Int @default(0) // intra-state
  sgst            Int @default(0)
  igst            Int @default(0) // inter-state

  couponId   String?
  couponCode String?

  // Fulfilment
  courierName    String?
  trackingNumber String?
  trackingUrl    String?
  deliveredAt    DateTime?
  cancelledAt    DateTime?
  cancelReason   String?

  paymentDueAt  DateTime? // UPI orders: stock is held until this time unless a UTR is submitted

  invoiceNumber String?  @unique
  invoicedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  coupon         Coupon?            @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  events         OrderStatusEvent[]
  payments       Payment[]
  refunds        Refund[]
  returns        ReturnRequest[]
  couponRedemption CouponRedemption?

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt])
  @@index([status, paymentDueAt])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  // Snapshot so history survives product edits/deletion
  brandName  String
  modelName  String
  reference  String
  sku        String
  imageUrl   String?
  hsnCode    String
  gstRatePct Decimal @db.Decimal(5, 2)
  mrp        Int
  unitPrice  Int
  quantity   Int
  lineTotal  Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  review  Review?

  @@index([orderId])
  @@index([productId])
}

model OrderStatusEvent {
  id             String      @id @default(cuid())
  orderId        String
  fromStatus     OrderStatus?
  toStatus       OrderStatus
  note           String?
  courierName    String?
  trackingNumber String?
  trackingUrl    String?
  actorId        String?     // null = system (webhook / customer action recorded separately in note)
  emailSentAt    DateTime?
  createdAt      DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation("StatusActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

/// One row per UTR the customer submits for an order (resubmissions create new rows).
model Payment {
  id                 String        @id @default(cuid())
  orderId            String
  amountPaise        Int
  utr                String        @unique // 12-digit UPI reference; unique so one payment can't settle two orders
  payerVpa           String?
  payerName          String?
  screenshotUrl      String?
  screenshotPublicId String?
  status             PaymentStatus @default(SUBMITTED)
  reviewedAt         DateTime?
  reviewedById       String?
  rejectReason       String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("PaymentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status, createdAt])
}

model Refund {
  id               String       @id @default(cuid())
  orderId          String
  reference        String?      // UTR / bank reference of the manual refund transfer
  amount           Int
  status           RefundStatus @default(PENDING)
  reason           String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model ReturnRequest {
  id        String       @id @default(cuid())
  orderId   String
  type      ReturnType
  reason    String
  details   String?      @db.Text
  status    ReturnStatus @default(REQUESTED)
  adminNote String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}


// ─────────────────────────────────────────────────────────────
// Coupons
// ─────────────────────────────────────────────────────────────

model Coupon {
  id            String     @id @default(cuid())
  code          String     @unique @db.Citext
  description   String?
  type          CouponType
  value         Decimal    @db.Decimal(10, 2) // % (0–100) or flat ₹
  maxDiscount   Int?       // cap for % coupons
  minOrderValue Int        @default(0)
  startsAt      DateTime?
  expiresAt     DateTime?
  usageLimit    Int?       // total redemptions
  perUserLimit  Int?       @default(1)
  usedCount     Int        @default(0)
  active        Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  orders      Order[]
  redemptions CouponRedemption[]

  @@index([active, expiresAt])
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  orderId   String   @unique
  amount    Int
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
}

// ─────────────────────────────────────────────────────────────
// Store configuration & content
// ─────────────────────────────────────────────────────────────

model StoreSettings {
  id                    Int      @id @default(1) // singleton row
  storeName             String
  logoUrl               String?
  contactEmail          String
  contactPhone          String
  whatsappNumber        String?
  addressLine           String
  gstin                 String?
  stateCode             String   // seller state → decides CGST+SGST vs IGST
  globalDiscountPct     Decimal  @default(0) @db.Decimal(5, 2)
  returnWindowDays      Int      @default(7)
  shippingFee           Int      @default(0)
  freeShippingThreshold Int?
  defaultDeliveryDays   Int      @default(5)
  expressShippingFee    Int?     // null = express not offered
  upiVpa                String?  // store's UPI ID, e.g. maison@okhdfcbank (UPI disabled at checkout until set)
  upiPayeeName          String?  // name shown in the customer's UPI app
  paymentWindowMinutes  Int      @default(30) // how long stock is held for an unpaid UPI order
  updatedAt             DateTime @updatedAt
}

// PIN-prefix based delivery estimates (admin-editable). Longest prefix wins.
model ShippingZone {
  id           String  @id @default(cuid())
  pinPrefix    String  @unique // "1", "11", "110" …
  label        String
  minDays      Int
  maxDays      Int
  serviceable  Boolean @default(true)
}

model HomeBanner {
  id         String    @id @default(cuid())
  eyebrow    String?
  title      String
  subtitle   String?
  imageUrl   String
  mobileImageUrl String?
  videoUrl   String?   // optional muted loop for hero
  ctaLabel   String?
  ctaHref    String?
  placement  String    @default("HERO") // HERO | STRIP | STORY
  position   Int       @default(0)
  active     Boolean   @default(true)
  startsAt   DateTime?
  endsAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([placement, active, position])
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique @db.Citext
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
}

// ─────────────────────────────────────────────────────────────
// Logs, imports, infra
// ─────────────────────────────────────────────────────────────

model PriceChangeLog {
  id            String           @id @default(cuid())
  scope         PriceChangeScope
  actorId       String
  productId     String?          // null for GLOBAL_DISCOUNT header row
  oldValue      String           // "5.00" / "₹10,00,000"
  newValue      String
  oldPrice      Int?             // per-product selling price before → after
  newPrice      Int?
  affectedCount Int?             // for GLOBAL_DISCOUNT: number of products repriced
  batchId       String?          // groups the per-product rows of one global change
  createdAt     DateTime         @default(now())

  actor   User     @relation("PriceActor", fields: [actorId], references: [id], onDelete: Restrict)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([productId, createdAt])
  @@index([batchId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String   // "product.update", "order.status", "settings.update" …
  entityType String
  entityId   String?
  diff       Json?    // { field: [old, new] }
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt(sort: Desc)])
}

model ImportJob {
  id           String       @id @default(cuid())
  kind         ImportKind
  status       ImportStatus @default(VALIDATING)
  fileName     String
  fileUrl      String?      // original upload kept for re-download
  actorId      String
  totalRows    Int          @default(0)
  createdCount Int          @default(0)
  updatedCount Int          @default(0)
  skippedCount Int          @default(0)
  failedCount  Int          @default(0)
  rowResults   Json?        // [{ row, sku, outcome, reason }]
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime     @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([createdAt(sort: Desc)])
}

// Postgres-backed fixed-window rate limiter (no extra service needed)
model RateLimit {
  key       String   @id // "auth:ip:1.2.3.4", "review:user:abc"
  count     Int
  resetAt   DateTime

  @@index([resetAt])
}

// Atomic sequences for order + invoice numbers
model Counter {
  key   String @id // "order:2026", "invoice:2026-27"
  value Int
}
